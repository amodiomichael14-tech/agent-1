# Copy this file to ".env" and fill in your values.
#   cp .env.example .env
# The .env file is git-ignored, so your secrets never get committed.

# --- Required ---

# Your Anthropic API key — https://console.anthropic.com/  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Your SendGrid API key — https://app.sendgrid.com/  ->  Settings -> API Keys
# (create a key with "Mail Send" permission)
SENDGRID_API_KEY=SG....

# The address emails are sent from. This MUST be a verified sender or domain
# in SendGrid (Settings -> Sender Authentication), or SendGrid rejects it.
FROM_EMAIL=you@yourdomain.com

# --- Optional ---

# Your name — shown as the "From" name and used as the email sign-off.
SENDER_NAME=Your Name

# Which Claude model writes the emails. Opus 4.8 is the most capable (default).
# For cheaper/faster runs, use claude-sonnet-4-6 or claude-haiku-4-5.
MODEL=claude-opus-4-8

# Seconds to wait between sends. Default: 2
SEND_DELAY_SECONDS=2

# Optional footer added to the bottom of every email. Recommended for
# compliance: a real physical mailing address + an opt-out line.
# EMAIL_FOOTER=Acme Co · 123 Main St, City, ST 00000 · Reply STOP to opt out.
